  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u672C\u30A2\u30D7\u30EA\u30B1\u30FC\u30B7\u30E7\u30F3 (\u4EE5\u4E0B\u300C\u672C\u30A2\u30D7\u30EA\u300D)
    \u306F\u3001\u30D7\u30ED\u30B0\u30E9\u30DF\u30F3\u30B0\u5B66\u7FD2\u3092\u76EE\u7684\u3068\u3057\u305F\u6559\u6750\u3067\u3059\u3002\u3054\u5229\u7528\u306B\u3042\u305F\u308A\u3001\u4EE5\u4E0B\u306E\u5185\u5BB9\u306B\u540C\u610F\u3044\u305F\u3060\u304F\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\u3002\n\n\u7B2C1\u6761
    (\u76EE\u7684)\n\u672C\u30A2\u30D7\u30EA\u306F\u6559\u80B2\u76EE\u7684\u3067\u63D0\u4F9B\u3055\u308C\u3001\u5B9F\u969B\u306E\u91D1\u92AD\u3092\u8CED\u3051\u308B\u884C\u70BA\u306F\u4E00\u5207\u542B\u307E\u308C\u307E\u305B\u3093\u3002\n\n\u7B2C2\u6761
    (\u30B2\u30FC\u30E0\u5185\u30C1\u30C3\u30D7)\n\u30B2\u30FC\u30E0\u5185\u306E\u30C1\u30C3\u30D7\u306F\u5B66\u7FD2\u7528\u306E\u4EEE\u60F3\u7684\u306A\u30DD\u30A4\u30F3\u30C8\u3067\u3042\u308A\u3001\u91D1\u92AD\u7684\u4FA1\u5024\u3092\u6301\u3061\u307E\u305B\u3093\u3002\u63DB\u91D1\u30FB\u8B72\u6E21\u306F\u3067\u304D\u307E\u305B\u3093\u3002\n\n\u7B2C3\u6761
    (\u30C7\u30FC\u30BF\u306E\u53D6\u308A\u6271\u3044)\n\u30D7\u30EC\u30A4\u30E4\u30FC\u540D\u304A\u3088\u3073\u30B2\u30FC\u30E0\u306E\u9032\u884C\u72B6\u6CC1\u306F\u3001\u304A\u4F7F\u3044\u306E\u7AEF\u672B\u5185\u3068\u30EC\u30C3\u30B9\u30F3\u7528\u30B5\u30FC\u30D0\u30FC\u306B\u306E\u307F\u4FDD\u5B58\u3055\u308C\u307E\u3059\u3002\n\n\u7B2C4\u6761
    (\u7981\u6B62\u4E8B\u9805)\n\u672C\u30A2\u30D7\u30EA\u306E\u89E3\u6790\u30FB\u6539\u5909\u306B\u3088\u3063\u3066\u3001\u4ED6\u306E\u53D7\u8B1B\u8005\u306E\u5B66\u7FD2\u3092\u59A8\u3052\u308B\u884C\u70BA\u3092\u7981\u6B62\u3057\u307E\u3059\u3002\n\n\u7B2C5\u6761
    (\u898F\u7D04\u306E\u5909\u66F4)\n\u672C\u898F\u7D04\u306F\u6388\u696D\u306E\u9032\u884C\u306B\u5FDC\u3058\u3066\u5909\u66F4\u3055\u308C\u308B\u3053\u3068\u304C\u3042\u308A\u307E\u3059\u3002\n\n\u4EE5\u4E0A\u306B\u540C\u610F\u306E\u4E0A\u3001\u300C\u540C\u610F\u3059\u308B\u300D\u3092\u62BC\u3057\u3066\u958B\u59CB\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
