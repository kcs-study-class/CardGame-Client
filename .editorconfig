# CardGame-Client コーディング規約 (Docs/CODING.md) の IDE 反映
# Rider / Visual Studio / dotnet format が読む。命名の正は Docs/CODING.md。
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

# ---- var 禁止 (型を明示する) ----
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning

# ---- 命名スタイル定義 ----
dotnet_naming_style.screaming_snake.capitalization = all_upper
dotnet_naming_style.screaming_snake.word_separator = _

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.interface_prefix.capitalization = pascal_case
dotnet_naming_style.interface_prefix.required_prefix = I

# ---- 対象シンボル定義 ----
# const (アクセシビリティ問わず) → SCREAMING_SNAKE_CASE
dotnet_naming_symbols.consts.applicable_kinds = field
dotnet_naming_symbols.consts.applicable_accessibilities = *
dotnet_naming_symbols.consts.required_modifiers = const

# static readonly → SCREAMING_SNAKE_CASE
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

# 可変 private static → UpperCamel (PascalCase)
dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private, protected, private_protected
dotnet_naming_symbols.private_static_fields.required_modifiers = static

# private インスタンスフィールド ([SerializeField] 含む) → _camelCase
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, protected, private_protected

# ※ public フィールドは規約なし (プロトコルDTOは wire 準拠の camelCase、
#    PlayerData 等は PascalCase と意図的に混在するためルール化しない)

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, enum, method, property, event, delegate
dotnet_naming_symbols.types_and_members.applicable_accessibilities = *

dotnet_naming_symbols.locals_and_params.applicable_kinds = parameter, local
dotnet_naming_symbols.locals_and_params.applicable_accessibilities = *

# ---- ルール適用 (上から順にマッチ) ----
dotnet_naming_rule.consts_screaming.symbols = consts
dotnet_naming_rule.consts_screaming.style = screaming_snake
dotnet_naming_rule.consts_screaming.severity = warning

dotnet_naming_rule.static_readonly_screaming.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_screaming.style = screaming_snake
dotnet_naming_rule.static_readonly_screaming.severity = warning

dotnet_naming_rule.private_static_pascal.symbols = private_static_fields
dotnet_naming_rule.private_static_pascal.style = pascal_case
dotnet_naming_rule.private_static_pascal.severity = warning

dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning

dotnet_naming_rule.interfaces_i_prefix.symbols = interfaces
dotnet_naming_rule.interfaces_i_prefix.style = interface_prefix
dotnet_naming_rule.interfaces_i_prefix.severity = warning

dotnet_naming_rule.types_pascal.symbols = types_and_members
dotnet_naming_rule.types_pascal.style = pascal_case
dotnet_naming_rule.types_pascal.severity = warning

dotnet_naming_rule.locals_camel.symbols = locals_and_params
dotnet_naming_rule.locals_camel.style = camel_case
dotnet_naming_rule.locals_camel.severity = suggestion
